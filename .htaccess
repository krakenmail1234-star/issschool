# ---------------------------------------------------------------
# Intelekta Skola — Hostinger (Apache / LiteSpeed) configuration
# Static site: no PHP, no WordPress, no build step.
# ---------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) intelektaskola.lv -> www.intelektaskola.lv (canonical domain used in sitemap)
  RewriteCond %{HTTP_HOST} ^intelektaskola\.lv$ [NC]
  RewriteRule ^ https://www.intelektaskola.lv%{REQUEST_URI} [L,R=301]

  # 3) Hide development-only folders that live in the Git repo
  RewriteRule (^|/)(wix-velo|wix-export|apps-script|api|deploy|\.agents|\.claude|\.git|\.github|node_modules)(/|$) - [F,L]

  # 4) Optional clean URLs: /par-mums -> par-mums.html (old .html links keep working)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Block repo / tooling files from being downloaded
<FilesMatch "(?i)(\.md|\.gs|\.yml|\.yaml|\.code-workspace|\.zip|\.ps1|package(-lock)?\.json|skills-lock\.json|\.gitignore|\.vercelignore|\.env.*)$">
  Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser caching (HTML always fresh; JS/CSS use ?v= cache-busting)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
