--- /dev/null
+++ b/styles/theme-light.css
@@ -0,0 +1,95 @@
+/* Intelekta Skola — light theme: white canvas, blue accents, navy contrast boxes.
+   Load AFTER aurora.css on every page (homepage included):
+   <link rel="stylesheet" href="/styles/theme-light.css" />                      */
+@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap');
+
+:root {
+  --bg: #ffffff; --bg2: #f5f8ff; --text: #0b1530; --muted: #5b6785;
+  --brand: #2563eb; --brand-lt: #1d4ed8; --brand-deep: #1e3a8a; --brand-electric: #2563eb;
+  --line: #e3e9f4; --navy: #0b1530; --tint: #eef4ff;
+  color-scheme: light;
+}
+
+/* Canvas */
+html, body, body.ambient { background: #fff !important; color: var(--text) !important; }
+body.ambient::before, body.ambient::after { opacity: .0 !important; }
+.isp-glow { background: radial-gradient(55% 60% at 85% 0%, rgba(37,99,235,.10), transparent 70%),
+            radial-gradient(40% 55% at 0% 60%, rgba(37,99,235,.06), transparent 70%) !important; }
+::selection { background: rgba(37,99,235,.18); color: var(--navy); }
+
+/* Headings: editorial serif, navy */
+main h1, main h2, section h1, section h2 {
+  font-family: 'Source Serif 4', Georgia, serif !important; font-weight: 700 !important;
+  letter-spacing: -.015em !important; color: var(--navy);
+}
+.brand-text { background: linear-gradient(120deg, #2563eb, #1e40af) !important;
+  -webkit-background-clip: text !important; background-clip: text !important; color: transparent !important; }
+
+/* Text colours (Tailwind utilities used on the site) */
+.text-white:not(.btn-primary):not(.btn-primary *), .text-zinc-50, .text-zinc-100, .text-zinc-200 { color: #0b1530 !important; }
+.text-zinc-300, .text-zinc-300\/90 { color: #334155 !important; }
+.text-zinc-400 { color: #475569 !important; }
+.text-zinc-500, .text-muted { color: #5b6785 !important; }
+.text-electric, .text-brand, .text-sky, .text-accent { color: #2563eb !important; }
+.text-brandlt, .hover\:text-brandlt:hover, .hover\:text-electric:hover { color: #1d4ed8 !important; }
+.text-sky-300, .text-sky-300 { color: #047857 !important; }
+
+/* Surfaces: every block sits in its own white box */
+.glass, .glass-strong {
+  background: #fff !important; border: 1px solid var(--line) !important;
+  box-shadow: 0 1px 2px rgba(11,21,48,.04), 0 12px 32px -16px rgba(11,21,48,.18) !important;
+  backdrop-filter: none !important;
+}
+.hairline { border: 1px solid var(--line) !important; }
+.bg-white\/5, .bg-white\/\[\.03\], .bg-white\/\[\.04\], .bg-white\/10 { background-color: #f5f8ff !important; }
+.hover\:bg-white\/5:hover, .hover\:bg-white\/10:hover, .hover\:bg-white\/\[\.06\]:hover { background-color: var(--tint) !important; }
+.border-white\/5, .border-white\/10 { border-color: var(--line) !important; }
+.bg-ink, .bg-ink2 { background-color: #fff !important; }
+.bg-electric\/10, .bg-brand\/15, .bg-brand\/10 { background-color: var(--tint) !important; }
+.bg-electric { background-color: #2563eb !important; }
+.glow { box-shadow: 0 0 0 1px rgba(37,99,235,.12), 0 18px 44px -18px rgba(37,99,235,.35) !important; }
+.glow-hover:hover, .isp-card:hover { border-color: #bcd0f5 !important;
+  box-shadow: 0 20px 44px -20px rgba(37,99,235,.35) !important; }
+.to-ink { --tw-gradient-to: #ffffff var(--tw-gradient-to-position) !important; }
+#hero-canvas { opacity: .35 !important; }
+
+/* Badges / labels: blue tint pill */
+.isp-badge, .isp-dot, main .rounded-full.uppercase, section .rounded-full.uppercase {
+  background: var(--tint) !important; border: 1px solid #cfdcf7 !important; color: #1d4ed8 !important;
+}
+.isp-badge:before, .isp-dot:before { background: #2563eb !important; box-shadow: none !important; }
+
+/* Buttons */
+.btn-primary { background: #2563eb !important; color: #fff !important; border: 1px solid #1d4ed8;
+  box-shadow: 0 8px 22px -10px rgba(37,99,235,.7) !important; }
+.btn-primary:hover { background: #1d4ed8 !important; filter: none !important; }
+a.hairline.rounded-full, button.hairline.rounded-full { background: #fff !important; color: #0b1530 !important;
+  border: 1px solid #cbd5e1 !important; }
+a.hairline.rounded-full:hover { border-color: #2563eb !important; color: #1d4ed8 !important; }
+
+/* Header: white bar with border */
+header .glass { background: rgba(255,255,255,.88) !important; backdrop-filter: blur(12px) !important; }
+header .text-zinc-300, header nav a { color: #334155 !important; }
+.langseg button { color: #5b6785 !important; }
+.langseg button.is-active { background: var(--tint) !important; color: #1d4ed8 !important; }
+
+/* Forms */
+.field { background: #fff !important; border: 1px solid #cbd5e1 !important; color: #0b1530 !important; }
+.field::placeholder { color: #94a3b8 !important; }
+.field:focus { border-color: #2563eb !important; box-shadow: 0 0 0 3px rgba(37,99,235,.15) !important; }
+
+/* Navy contrast boxes: closing CTA blocks and the footer */
+.glass-strong, footer {
+  background: #0b1530 !important; color: #e6ecfb !important; border-color: #0b1530 !important;
+}
+.glass-strong h1, .glass-strong h2, .glass-strong h3, .glass-strong .text-white,
+.glass-strong .text-zinc-100, .glass-strong .text-zinc-200 { color: #fff !important; }
+.glass-strong .text-zinc-300, .glass-strong .text-zinc-400, .glass-strong p,
+footer, footer a, footer .text-zinc-500 { color: #b9c5e4 !important; }
+footer a:hover { color: #fff !important; }
+.glass-strong .brand-text { background: linear-gradient(120deg, #93c5fd, #60a5fa) !important;
+  -webkit-background-clip: text !important; background-clip: text !important; }
+.glass-strong .btn-primary { background: #fff !important; color: #0b1530 !important; border-color: #fff; }
+.glass-strong .text-electric, footer .text-electric { color: #93c5fd !important; }
+main section > .pointer-events-none.absolute.inset-0 { opacity: .35 !important; }
+.glass-strong .glass, .glass-strong .hairline, .glass-strong .bg-white\/5 { background: rgba(255,255,255,.07) !important; border-color: rgba(255,255,255,.14) !important; box-shadow: none !important; }
