diff --git a/scripts/site-polish.js b/scripts/site-polish.js
new file mode 100644
index 0000000..71d0694
--- /dev/null
+++ b/scripts/site-polish.js
@@ -0,0 +1,105 @@
+/* Intelekta Skola — site-polish.js
+   Brings every inner page in line with the homepage look:
+   hero glow, badge label, glowing buttons and cards, scroll reveal,
+   and a safe fallback for broken images.
+   Include on every page except the homepage, right after the other scripts:
+   <script src="/scripts/site-polish.js" defer></script>                      */
+(function () {
+  if (window.__isPolish) return; window.__isPolish = true;
+  var main = document.querySelector('main');
+  if (!main) return;
+  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+  // 1) Styles (scoped, no dependency on Tailwind building new classes)
+  var css = [
+    '.isp-glow{position:absolute;left:0;right:0;top:0;height:900px;pointer-events:none;z-index:0;',
+    'background:radial-gradient(55% 60% at 85% 0%,rgba(37,99,235,.26),transparent 70%),',
+    'radial-gradient(40% 55% at 0% 70%,rgba(30,58,138,.28),transparent 70%)}',
+    '.isp-badge{display:inline-flex!important;align-items:center;gap:.5rem;border-radius:9999px;',
+    'border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.05);padding:.375rem 1rem;',
+    'letter-spacing:.2em!important;margin-bottom:.5rem}',
+    '.isp-badge:before{content:"";width:6px;height:6px;border-radius:9999px;background:#60a5fa;box-shadow:0 0 10px #60a5fa}',
+    '.isp-card{transition:transform .35s cubic-bezier(.25,0,0,1),box-shadow .35s,border-color .35s}',
+    'main .isp-card:hover{transform:translateY(-3px);border-color:rgba(96,165,250,.28)!important;',
+    'box-shadow:0 18px 50px -20px rgba(37,99,235,.55)}',
+    '.isp-btn{box-shadow:0 10px 40px -10px rgba(96,165,250,.55)}',
+    '.isp-reveal{opacity:0;transform:translateY(18px);transition:opacity .7s cubic-bezier(.25,0,0,1),transform .7s cubic-bezier(.25,0,0,1)}',
+    '.isp-reveal.isp-in{opacity:1;transform:none}',
+    '.isp-imgfail{background:radial-gradient(70% 70% at 70% 20%,rgba(96,165,250,.25),transparent 60%),linear-gradient(135deg,#0e1629,#070b18)}',
+    '.isp-dot{display:inline-flex!important;align-items:center;gap:.5rem}',
+    '.isp-dot:before{content:"";width:6px;height:6px;border-radius:9999px;background:#60a5fa;box-shadow:0 0 10px #60a5fa}',
+    '.isp-sec{border-radius:1.5rem;padding:1.5rem}',
+    '@media(min-width:640px){.isp-sec{padding:2rem}}',
+    '.isp-h2{letter-spacing:-.01em}',
+    'main h1{text-wrap:balance}'
+  ].join('');
+  var st = document.createElement('style'); st.id = 'isp-style'; st.textContent = css;
+  document.head.appendChild(st);
+
+  // 2) Hero glow behind the top of the page
+  if (!document.querySelector('.isp-glow')) {
+    var g = document.createElement('div'); g.className = 'isp-glow';
+    document.body.insertBefore(g, document.body.firstChild);
+  }
+
+  // 3) Small label above the first h1 -> homepage-style badge
+  var h1 = main.querySelector('h1');
+  if (h1) {
+    var prev = h1.previousElementSibling;
+    var hasDot = prev && (/^[●•]/.test(prev.textContent.trim()) || prev.querySelector('[class*="rounded-full"], svg'));
+    if (prev && !hasDot && /uppercase/.test(prev.className) && prev.textContent.trim().length < 60) {
+      prev.classList.add(/rounded-full/.test(prev.className) ? 'isp-dot' : 'isp-badge');
+    }
+    h1.classList.add('leading-[1.05]');
+  }
+
+  // 3b) Plain content sections (product pages, about) -> glass cards like the homepage
+  main.querySelectorAll(':scope > section').forEach(function (sec) {
+    if (/glass/.test(sec.className) || sec.querySelector('.glass, form, article')) return;
+    if (!sec.querySelector('h2')) return;
+    sec.classList.add('glass', 'isp-card', 'isp-sec');
+    var h2 = sec.querySelector('h2');
+    if (h2) h2.classList.add('isp-h2');
+  });
+
+  // 4) Cards get the homepage hover glow
+  main.querySelectorAll('.glass').forEach(function (el) {
+    if (el.tagName === 'FORM' || el.closest('form')) return;
+    if (el.querySelector('input, textarea, select')) return; // keep tool panels still
+    if (/glow-hover/.test(el.className)) return;
+    if (el.offsetWidth > 0 && el.offsetWidth < 1100) el.classList.add('isp-card');
+  });
+
+  // 5) Primary buttons glow like the homepage CTA
+  document.querySelectorAll('main .btn-primary').forEach(function (b) {
+    if (!/btn-glow/.test(b.className)) b.classList.add('isp-btn');
+  });
+
+  // 6) Broken images: hide the broken icon, keep a branded gradient
+  function failImg(img) {
+    img.style.visibility = 'hidden';
+    if (img.parentElement) img.parentElement.classList.add('isp-imgfail');
+  }
+  main.querySelectorAll('img').forEach(function (img) {
+    if (img.complete && img.naturalWidth === 0 && img.getAttribute('src')) failImg(img);
+    img.addEventListener('error', function () { failImg(img); });
+  });
+
+  // 7) Scroll reveal for sections and cards (homepage feel)
+  if (!reduce && 'IntersectionObserver' in window) {
+    var targets = main.querySelectorAll(':scope > section, :scope > div > section, .glass, article, h2');
+    var vh = window.innerHeight;
+    var io = new IntersectionObserver(function (es) {
+      es.forEach(function (e) {
+        if (e.isIntersecting) { e.target.classList.add('isp-in'); io.unobserve(e.target); }
+      });
+    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
+    targets.forEach(function (el, i) {
+      if (el.closest('.isp-reveal')) return;
+      if (el.getBoundingClientRect().top < vh) return; // never hide what is already on screen
+      el.classList.add('isp-reveal');
+      el.style.transitionDelay = ((i % 3) * 0.06) + 's';
+      io.observe(el);
+    });
+  }
+})();
